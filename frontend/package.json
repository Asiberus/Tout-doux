{
  "name": "frontend",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "type-check": "vue-tsc --noEmit",
    "serve": "vite preview",
    "lint": "eslint --fix",
    "format": "prettier . --write",
    "prepare": "cd .. && husky frontend/.husky",
    "docker:build": "docker compose --env-file ../.conf/development/conf.env build",
    "docker:up": "docker compose --env-file ../.conf/development/conf.env up",
    "docker:prod:build": "docker compose --file ../docker-compose.prod.yml --env-file ../.conf/production/conf.env build",
    "docker:prod:up": "docker compose --file ../docker-compose.prod.yml --env-file ../.conf/production/conf.env up"
  },
  "dependencies": {
    "@vue/devtools-api": "^8.1.5",
    "axios": "^1.18.1",
    "deep-equal": "^2.2.3",
    "moment": "^2.30.1",
    "pinia": "^4.0.2",
    "vite-plugin-vuetify": "^2.1.3",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "vuetify": "^4.1.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "19.5.0",
    "@eslint/js": "^9.14.0",
    "@types/deep-equal": "^1.0.4",
    "@types/eslint__js": "^8.42.3",
    "@typescript-eslint/eslint-plugin": "^8.12.2",
    "@typescript-eslint/parser": "^8.12.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.1.3",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-vue": "^9.30.0",
    "eslint-plugin-vuetify": "^2.7.2",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "pretty-quick": "^4.0.0",
    "sass": "^1.102.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.12.2",
    "vite": "^8.2.0",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^3.3.8"
  },
  "optionalDependencies": {
    "@rollup/rollup-android-arm-eabi": "*",
    "@rollup/rollup-android-arm64": "*",
    "@rollup/rollup-darwin-arm64": "*",
    "@rollup/rollup-darwin-x64": "*",
    "@rollup/rollup-linux-arm-gnueabihf": "*",
    "@rollup/rollup-linux-arm-musleabihf": "*",
    "@rollup/rollup-linux-arm64-gnu": "*",
    "@rollup/rollup-linux-arm64-musl": "*",
    "@rollup/rollup-linux-powerpc64le-gnu": "*",
    "@rollup/rollup-linux-riscv64-gnu": "*",
    "@rollup/rollup-linux-s390x-gnu": "*",
    "@rollup/rollup-linux-x64-gnu": "*",
    "@rollup/rollup-linux-x64-musl": "*"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "volta": {
    "node": "22.23.1",
    "yarn": "1.22.19"
  }
}
